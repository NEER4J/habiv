# Supabase (Project settings > API). The publishable key is the sb_publishable_... key (or the legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=https://apppassecstqpncmfyzw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=                       # server only, never NEXT_PUBLIC

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000       # https://habiv.com in production
NEXT_PUBLIC_GAME_ORIGIN=https://habiv-play.<account>.workers.dev
# NEXT_PUBLIC_CDN_ORIGIN=https://cdn.habiv.com   # unset = the Supabase public bucket URL

# Object storage: Supabase Storage over its S3 API (Storage > S3 Configuration > Access keys).
# The endpoint defaults to this project's; set it (and region "auto") to move to Cloudflare R2.
# STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-2
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_UPLOADS_BUCKET=habiv-uploads
STORAGE_GAMES_BUCKET=habiv-games
STORAGE_PUBLIC_BUCKET=habiv-public

# Jobs and secrets
CRON_SECRET=                                     # openssl rand -hex 32; Vercel Cron and the pg_cron sweeper send it as a Bearer token
GITHUB_DISPATCH_TOKEN=                           # fine-grained PAT for this repo, Contents: read & write; fires .github/workflows/jobs.yml
# GITHUB_REPOSITORY=NEER4J/habiv                 # defaults to the repo Vercel deploys from
RUN_TOKEN_SECRET=                                # openssl rand -hex 32; signs play-run tokens
GAME_ORIGIN_HOOK_SECRET=                         # openssl rand -hex 32; shared with the game-origin Worker
