{
  "name": "habiv-jobs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-contracts": "cp ../lib/contracts/ingest.ts src/contracts/ingest.ts && cp ../lib/bridge/habiv-bridge.js src/lib/habiv-bridge.js",
