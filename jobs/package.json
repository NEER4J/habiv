    "smoke": "tsx src/cli.ts smoke-version",
    "prune": "tsx src/cli.ts prune"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@ruffle-rs/ruffle": "^0.6.0",
    "@supabase/supabase-js": "^2.100.0",
    "@turbowarp/packager": "^3.13.0",
    "love.js": "^11.4.1",
    "mime-types": "^3.0.0",
    "p-limit": "^6.2.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^2.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
